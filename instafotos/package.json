{
  "name": "instafotos",
  "productName": "InstaFotos",
  "version": "1.0.0",
  "description": "InstaFotos — veja e baixe as fotos de um perfil ou post do Instagram. Desenvolvido por DLTechSup.",
  "author": {
    "name": "DLTechSup",
    "email": "dltechsup@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "engine": "node scripts/build-engine.mjs",
    "dist": "npm run engine && electron-builder",
    "dist:win": "npm run engine && electron-builder --win",
    "dist:mac": "npm run engine && electron-builder --mac",
    "dist:linux": "npm run engine && electron-builder --linux"
  },
  "build": {
    "appId": "com.dltechsup.instafotos",
    "productName": "InstaFotos",
    "artifactName": "InstaFotos-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "publisherName": "DLTechSup"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InstaFotos",
      "uninstallDisplayName": "InstaFotos ${version} (DLTechSup)",
      "artifactName": "InstaFotos-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1046"
    },
    "portable": {
      "artifactName": "InstaFotos-Portatil-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.photography",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "icon": "build/icon.png",
      "maintainer": "DLTechSup <dltechsup@users.noreply.github.com>",
      "executableName": "instafotos",
      "synopsis": "Veja e baixe as fotos de um perfil do Instagram",
      "vendor": "DLTechSup"
    },
    "copyright": "Copyright © 2026 DLTechSup",
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
